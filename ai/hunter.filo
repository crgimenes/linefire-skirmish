; hunter.filo — a first skirmish pilot, and a tour of the contract.
;
; Run it as faction 1 against the house brain:
;
;   go run ./cmd/linefire-skirmish -ai ai/hunter.filo
;
; The program runs once per tick for EACH ship of its faction. Everything you
; (def ...) survives to the next tick — that is the ship's memory — but the
; whole program re-runs every tick, so initialise memory only on the first one:

(if first-tick (def patrol-heading 0))

; The instruments are plain globals, refreshed every tick: self-x self-y
; self-heading self-hull self-speed self-radar fire-ready field-w field-h,
; and the sensor lists. "enemies" holds only what this ship can SEE — inside
; its radar and not behind rock — nearest first. Each contact is a list:
;   (kind x y heading dist)

(if (is-empty enemies)
    ; Nobody in sight: sweep the field. Turning a little each tick traces a
    ; wide curve, which covers ground better than flying straight forever.
    (do
      (def patrol-heading (norm-angle (+ patrol-heading 0.4)))
      (move (cos patrol-heading) (sin patrol-heading)))

    ; Fight the nearest contact: face it, hold a fighting distance, shoot.
    (let ((target (head enemies)))
      (let ((tx (nth target 1))
            (ty (nth target 2))
            (d  (nth target 4)))
        (do
          ; Aim first. bearing gives the angle from us to them, in degrees.
          (face (bearing self-x self-y tx ty))
          ; Too far: close in. Close enough: strafe sideways (the perpendicular
          ; of the direction to the target), which makes us harder to hit.
          (if (> d 240)
              (move (- tx self-x) (- ty self-y))
              (move (- self-y ty) (- tx self-x)))
          ; fire returns #t only when the shot actually leaves: the cooldown
          ; belongs to the engine, so spamming it is free and useless.
          (fire tx ty)))))
