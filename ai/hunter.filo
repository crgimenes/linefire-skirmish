; hunter.filo — a first skirmish pilot, and a tour of the contract.
;
; Run it as faction 1 against the house brain:
;
;   go run ./cmd/linefire-skirmish -ai ai/hunter.filo
;
; The program runs once per tick for EACH ship of its faction. Everything you
; (def ...) survives to the next tick — that is the ship's memory — but the
; whole program re-runs every tick, so initialise memory only on the first one:

; Each ship starts its corner tour at a different point (derived from where it
; materialised), so the fleet spreads instead of parading in single file. BOTH
; coordinates go into it: deriving the corner from self-x alone gave every hull
; that landed down one side of the map the same destination, and a maze punishes
; that — four of them were measured jammed shoulder to shoulder in one pocket,
; each shoving the others into the rock, for a whole battle.
(if first-tick (def waypoint (+ (floor (/ self-x 600)) (floor (/ self-y 400)))))

; The instruments are plain globals, refreshed every tick: self-x self-y
; self-heading self-hull self-hull-max self-shield self-speed self-radar
; fire-ready field-w field-h, and the sensor lists. "enemies" holds only what
; this ship can SEE — inside its radar and not behind rock — nearest first.
; Each contact is a list:
;   (kind x y heading dist)
; and "loot" is the pickups in sight, one field shorter (a canister has no
; heading to report):
;   (kind x y dist)

; A wounded hull breaks off for the nearest canister. Flying over one salvages
; it, so wanting it is the whole of taking it — and the enemy program can see
; the same canister, which is what makes the field worth contesting.
(if (and (not (is-empty loot))
         (< self-hull (- self-hull-max 1)))
    (let ((can (head loot)))
      (seek (nth can 1) (nth can 2)))

(if (is-empty enemies)
    ; Nobody in sight: patrol the field's corners with seek, which rides the
    ; engine's pathfinding — in a maze this WALKS the corridors, where a blind
    ; (move) would press into the first wall and stay there. Each ship starts
    ; on a different corner (see waypoint above) and advances when it arrives.
    (let ((wx (if (< (mod waypoint 4) 2) 200 (- field-w 200)))
          (wy (if (< (mod (+ waypoint 1) 4) 2) 200 (- field-h 200))))
      (do
        ; Two reasons to move on. Arriving is the obvious one. The other is the
        ; engine telling us it has no route there at all — a maze puts corners
        ; inside the rock, and self-nav-blocked is how the engine says so
        ; instead of quietly grinding the hull against a wall. Either way, the
        ; answer is the same: pick the next corner.
        (if (or (< (dist self-x self-y wx wy) 120) self-nav-blocked)
            (def waypoint (+ waypoint 1)))
        (seek wx wy)))

    ; Fight the nearest contact: face it, hold a fighting distance, shoot.
    (let ((target (head enemies)))
      (let ((tx (nth target 1))
            (ty (nth target 2))
            (d  (nth target 4)))
        (do
          ; Aim first. bearing gives the angle from us to them, in degrees.
          (face (bearing self-x self-y tx ty))
          ; Too far: close in with seek — it rides the engine's pathfinding,
          ; so rock is walked around, not pressed into. Close enough: strafe
          ; sideways with move (the perpendicular of the direction to the
          ; target), which makes us harder to hit. One navigation order per
          ; tick: the last of (seek)/(move) wins.
          (if (> d 240)
              (seek tx ty)
              (move (- self-y ty) (- tx self-x)))
          ; fire returns #t only when the shot actually leaves: the cooldown
          ; belongs to the engine, so spamming it is free and useless.
          ;
          ; Except with the devourer. Salvaging is automatic — flying over a
          ; canister takes it, so the wounded-hull rule above can hand this
          ; ship a black hole it never asked for. A dropped weapon ignores
          ; (fire)'s point and lands at OUR feet, and this one drags in every
          ; hull nearby whatever colour it flies. So hold it while a wingman
          ; is in sight, and spring it only when we are alone with the enemy.
          ; (A sharper program would read "loot" and never fly over the
          ; canister in the first place — that one is yours to write.)
          (if (or (not (= self-weapon "devourer")) (is-empty allies))
              (fire tx ty)))))))
